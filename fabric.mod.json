{
	"schemaVersion": 1,
	"id": "magic",
	"version": "${version}",
	"name": "Magic",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/magic/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "tintiksavo.magic.Magic",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "tintiksavo.magic.client.MagicClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "tintiksavo.magic.client.MagicDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"magic.mixins.json",
		{
			"config": "magic.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"immersive_portals": "*",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"geckolib": ">=4.8.4"
	}
}
